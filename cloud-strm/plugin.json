{
  "id": "cloud-strm",
  "name": "云盘 STRM",
  "version": "1.0.1",
  "api_version": 1,
  "requires_host": ">=1.2.2,<2",
  "data_version": 1,
  "author": "plsy1",
  "description": "扫描 CD2 等挂载目录，按 Nginx 路径规则生成 STRM，支持配套文件、增量扫描和 Emby 刷新。",
  "capabilities": [
    "library.refresh"
  ],
  "settings": {
    "fields": [
      {
        "id": "auto_scan",
        "type": "boolean",
        "label": "定时扫描",
        "default": false,
        "description": "按检查间隔扫描挂载目录，跳过未变更文件。"
      },
      {
        "id": "poll_seconds",
        "type": "integer",
        "label": "检查间隔（秒）",
        "default": 300,
        "minimum": 60,
        "maximum": 86400
      },
      {
        "id": "scan_on_start",
        "type": "boolean",
        "label": "插件启用后扫描一次",
        "default": false
      },
      {
        "id": "video_extensions",
        "type": "string_list",
        "label": "视频扩展名",
        "default": [
          "mkv",
          "mp4",
          "avi",
          "ts",
          "m2ts",
          "mov",
          "wmv",
          "iso"
        ],
        "max_length": 40
      },
      {
        "id": "copy_subtitles",
        "type": "boolean",
        "label": "复制字幕",
        "default": true
      },
      {
        "id": "copy_nfo",
        "type": "boolean",
        "label": "复制 NFO",
        "default": true
      },
      {
        "id": "copy_images",
        "type": "boolean",
        "label": "复制海报和图片",
        "default": false
      },
      {
        "id": "metadata_max_mb",
        "type": "integer",
        "label": "单个配套文件大小上限（MB）",
        "default": 20,
        "minimum": 1,
        "maximum": 64
      },
      {
        "id": "refresh_emby",
        "type": "boolean",
        "label": "生成后通知 Emby 刷新",
        "default": false,
        "description": "使用主程序配置的 Emby 地址；目录映射中填写 Emby 实际看到的 STRM 输出目录。刷新失败可以重试。"
      }
    ]
  },
  "ui": {
    "schema_version": 1,
    "description": "将 CD2 的 115 目录挂载到 Kanojo 后添加映射。源视频保持原样；播放时由现有 Nginx/OpenList 链路取得 115 直链。",
    "sections": [
      {
        "type": "action",
        "id": "mapping",
        "title": "添加或编辑映射",
        "label": "保存目录映射",
        "reset_label": "新建映射",
        "endpoint": "/rules",
        "inputs": [
          {
            "id": "name",
            "type": "string",
            "label": "映射名称",
            "required": true,
            "max_length": 80,
            "description": "例如 115 电影。"
          },
          {
            "id": "source_dir",
            "type": "string",
            "label": "CD2 源目录（Kanojo 内）",
            "required": true,
            "description": "挂载到 Kanojo 容器中的目录，例如 /cloud/115/电影。"
          },
          {
            "id": "target_dir",
            "type": "string",
            "label": "STRM 输出目录（Kanojo 内）",
            "required": true,
            "description": "例如 /strm/电影，保持原有文件夹结构。"
          },
          {
            "id": "mode",
            "type": "enum",
            "label": "STRM 内容格式",
            "options": [
              "路径",
              "URL",
              "模板"
            ],
            "default": "路径"
          },
          {
            "id": "playback_root",
            "type": "string",
            "label": "STRM 内容前缀或模板",
            "default": "/115",
            "required": true,
            "description": "Nginx 识别的原视频路径前缀，如 /115/电影；URL 或模板模式填写对应规则。"
          },
          {
            "id": "emby_root",
            "type": "string",
            "label": "STRM 输出目录（Emby 内，可留空）",
            "default": "",
            "description": "仅用于媒体库刷新，如 /media/电影；留空使用 Kanojo 输出目录。"
          },
          {
            "id": "enabled",
            "type": "boolean",
            "label": "启用此映射",
            "default": true
          }
        ],
        "groups": [
          {
            "title": "目录位置",
            "description": "填写 Kanojo 实际可以访问的源目录和输出位置。",
            "fields": [
              "name",
              "source_dir",
              "target_dir"
            ],
            "columns": 1
          },
          {
            "title": "播放与刷新",
            "description": "STRM 内容对应现有 Nginx / OpenList 播放规则。",
            "fields": [
              "mode",
              "playback_root",
              "emby_root",
              "enabled"
            ],
            "columns": 1
          }
        ]
      },
      {
        "type": "table",
        "id": "rules",
        "title": "目录映射",
        "endpoint": "/rules",
        "columns": [
          {
            "key": "name",
            "label": "名称"
          },
          {
            "key": "source_dir",
            "label": "源目录"
          },
          {
            "key": "target_dir",
            "label": "STRM 目录"
          },
          {
            "key": "preview",
            "label": "STRM 内容示例"
          }
        ],
        "actions": [
          {
            "label": "编辑",
            "fill_form": "mapping"
          },
          {
            "label": "扫描",
            "endpoint": "/rules/scan"
          },
          {
            "label": "移除",
            "endpoint": "/rules/remove",
            "confirm": "移除此目录映射？已生成的 STRM 和源视频都会保留。"
          }
        ]
      },
      {
        "type": "settings",
        "id": "generation",
        "title": "扫描与配套文件",
        "fields": [
          "auto_scan",
          "poll_seconds",
          "scan_on_start",
          "video_extensions",
          "copy_subtitles",
          "copy_nfo",
          "copy_images",
          "metadata_max_mb"
        ],
        "groups": [
          {
            "title": "扫描策略",
            "fields": [
              "auto_scan",
              "scan_on_start",
              "poll_seconds",
              "video_extensions"
            ],
            "columns": 1
          },
          {
            "title": "配套文件",
            "fields": [
              "copy_subtitles",
              "copy_nfo",
              "copy_images",
              "metadata_max_mb"
            ],
            "columns": 1
          }
        ]
      },
      {
        "type": "actions",
        "id": "scan",
        "title": "开始生成",
        "description": "按目录映射扫描；未变更的文件会跳过，源目录离线时保留已有输出。",
        "actions": [
          {
            "label": "增量扫描",
            "endpoint": "/scan"
          },
          {
            "label": "重新检查全部文件",
            "endpoint": "/rebuild"
          }
        ]
      },
      {
        "type": "task_status",
        "id": "tasks",
        "title": "任务进度"
      },
      {
        "type": "table",
        "id": "records",
        "title": "生成记录",
        "endpoint": "/records",
        "columns": [
          {
            "key": "rule",
            "label": "映射"
          },
          {
            "key": "title",
            "label": "源文件"
          },
          {
            "key": "state",
            "label": "状态",
            "format": "status"
          },
          {
            "key": "error",
            "label": "详情"
          }
        ],
        "actions": [
          {
            "label": "重新检查",
            "endpoint": "/retry"
          }
        ]
      },
      {
        "type": "table",
        "id": "runs",
        "title": "最近扫描",
        "endpoint": "/runs",
        "columns": [
          {
            "key": "started_at",
            "label": "时间",
            "format": "datetime"
          },
          {
            "key": "state",
            "label": "状态",
            "format": "status"
          },
          {
            "key": "created",
            "label": "新增"
          },
          {
            "key": "updated",
            "label": "更新"
          },
          {
            "key": "skipped",
            "label": "跳过"
          },
          {
            "key": "failed",
            "label": "失败"
          },
          {
            "key": "error",
            "label": "详情"
          }
        ]
      },
      {
        "type": "settings",
        "id": "emby_settings",
        "title": "Emby 刷新设置",
        "fields": [
          "refresh_emby"
        ]
      },
      {
        "type": "action",
        "id": "refresh",
        "title": "Emby 刷新重试",
        "label": "重试待刷新文件",
        "endpoint": "/refresh"
      },
      {
        "type": "table",
        "id": "pending",
        "title": "待刷新记录",
        "endpoint": "/refresh",
        "columns": [
          {
            "key": "path",
            "label": "Emby 内路径"
          },
          {
            "key": "state",
            "label": "状态",
            "format": "status"
          },
          {
            "key": "error",
            "label": "详情"
          }
        ]
      }
    ],
    "tabs": [
      {
        "id": "mapping",
        "label": "目录映射",
        "description": "先保存目录映射，再到「生成与记录」开始生成。",
        "sections": [
          "mapping",
          "rules"
        ]
      },
      {
        "id": "settings",
        "label": "生成设置",
        "sections": [
          "generation"
        ]
      },
      {
        "id": "activity",
        "label": "生成与记录",
        "sections": [
          "scan",
          "tasks",
          "records",
          "runs"
        ]
      },
      {
        "id": "emby",
        "label": "Emby 刷新",
        "sections": [
          "emby_settings",
          "refresh",
          "pending"
        ]
      }
    ]
  }
}
