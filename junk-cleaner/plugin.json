{
  "id": "junk-cleaner",
  "name": "垃圾文件清理",
  "version": "1.2.0",
  "description": "按插件独立配置的路径和关键词扫描文件，勾选确认后批量清理。",
  "author": "plsy1",
  "ui": {
    "title": "垃圾文件清理",
    "description": "按本插件保存的清理关键词匹配文件名，扫描后勾选确认删除；也可临时覆盖本次扫描路径。",
    "config": {
      "title": "清理设置",
      "description": "路径和关键词均独立保存在本插件中。文件名包含任意关键词即命中，不区分大小写；关键词留空时不清理。",
      "fields": [
        {
          "id": "scan_paths",
          "label": "默认扫描路径",
          "placeholder": "例如：\n/downloads\n/media/jav",
          "type": "textarea",
          "rows": 4
        },
        {
          "id": "keywords",
          "label": "清理关键词",
          "placeholder": "每行一个关键词，也可用逗号分隔，例如：\n游戏大全\n广告",
          "type": "textarea",
          "rows": 4
        }
      ],
      "load": {
        "endpoint": "/settings",
        "method": "GET"
      },
      "save": {
        "label": "保存设置",
        "endpoint": "/settings",
        "method": "POST"
      }
    },
    "inputs": [
      {
        "id": "path",
        "label": "临时扫描路径，留空则使用上方默认路径"
      }
    ],
    "primary": {
      "label": "扫描",
      "endpoint": "/scan",
      "method": "POST",
      "itemsKey": "items",
      "emptyText": "未发现垃圾文件。"
    },
    "columns": [
      {
        "key": "name",
        "label": "文件名"
      },
      {
        "key": "relative_path",
        "label": "路径"
      },
      {
        "key": "size",
        "label": "大小",
        "format": "size",
        "align": "right"
      }
    ],
    "rowKey": "path",
    "bulk": {
      "label": "删除所选",
      "endpoint": "/delete",
      "method": "POST",
      "field": "paths",
      "confirm": "确定删除选中的文件？此操作不可恢复。",
      "color": "warn"
    }
  }
}
